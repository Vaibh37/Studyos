{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/get-started",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/study-planner",
      "destination": "/seo/study-planner.html"
    },
    {
      "source": "/focus-timer",
      "destination": "/seo/focus-timer.html"
    },
    {
      "source": "/study-groups",
      "destination": "/seo/study-groups.html"
    },
    {
      "source": "/notes",
      "destination": "/seo/notes.html"
    },
    {
      "source": "/progress",
      "destination": "/seo/progress.html"
    },
    {
      "source": "/start",
      "destination": "/seo/start.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
